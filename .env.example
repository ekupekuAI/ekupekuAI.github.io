# The site is static and holds no secrets. Anything that needs a key (sending mail via
# Resend, GitHub's authenticated API) runs on a small Next.js backend — the
# `ekupekuAI/portfolio` repo, deployed on Vercel — and this is its address.
VITE_API_BASE=https://portfolio-a5y6.vercel.app

# Local development: copy this line into .env.development.local to use a local backend
# (`npm run dev` in the portfolio repo, port 3000). Never put it in .env.local — Vite bakes
# that into production builds too.
# VITE_API_BASE=http://localhost:3000
